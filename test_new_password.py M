import string
from password.new_password import generate_password
def test_password_characters():
    """Тест, что при генерации используются только допустимые символы"""
    valid_characters = string.ascii_letters + string.digits + string.punctuation
    password = generate_password(100)  # Генерируем длинный пароль для более надежной проверки
    for char in password:
        assert char in valid_characters


def test_password_length():
    """Тест, что длина пароля соответствует заданной"""
    length = 12
    password = generate_password(length)
    assert len(password) == length

    # Проверим ещё пару значений, чтобы убедиться в универсальности
    for length in [1, 50, 100]:
        password = generate_password(length)
        assert len(password) == length


def test_different_passwords():
    """Тест, что два сгенерированных подряд пароля различаются"""
    password1 = generate_password(16)
    password2 = generate_password(16)
    assert password1 != password2


def test_minimum_requirements():
    """Тест, что в пароле есть хотя бы по одному символу из основных групп"""
    password = generate_password(20)

    has_lower = any(c in string.ascii_lowercase for c in password)
    has_upper = any(c in string.ascii_uppercase for c in password)
    has_digit = any(c in string.digits for c in password)
    has_punct = any(c in string.punctuation for c in password)

    assert has_lower, "В пароле нет строчных букв"
    assert has_upper, "В пароле нет прописных букв"
    assert has_digit, "В пароле нет цифр"
    assert has_punct, "В пароле нет спецсимволов"


def test_edge_case_length():
    """Тест граничного случая: минимальная длина пароля"""
    password = generate_password(1)
    assert len(password) == 1
    # И проверим, что этот единственный символ — валидный
    valid_characters = string.ascii_letters + string.digits + string.punctuation
    assert password in valid_characters
